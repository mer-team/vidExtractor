{
  "name": "vid-extractor",
  "version": "1.0.0",
  "description": "Microservice to download YouTube audio using ytdl-core",
  "homepage": "https://mermaid.dei.uc.pt",
  "main": "src/index.js",
  "bugs": {
    "url": "https://github.com/mer-team/vidExtractor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:mer-team/mermaid-fe.git"
  },
  "author": "MERmaid Team (https://github.com/orgs/mer-team/people)",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "npx nyc --instrument -- mocha test/test.js --timeout 10000",
    "lint": "npx eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:docker": "hadolint Dockerfile .devcontainer/Dockerfile",
    "lint:compose": "npx yaml-lint compose.yml .github/workflows/*.yml .devcontainer/docker-compose.yml",
    "lint:markdown": "markdownlint '**/*.md' --ignore node_modules",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npx prettier . --write",
    "format": "npm run prettier:fix && npm run lint:fix",
    "audit": "npm audit --omit=dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.15.9",
    "amqplib": "^0.10.5",
    "cli-table3": "^0.6.3",
    "progress": "^2.0.3",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ytdl-core": "npm:@distube/ytdl-core@^4.16.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.22.0",
    "@istanbuljs/nyc-config-babel": "^3.0.0",
    "assert": "^2.1.0",
    "chai": "^5.2.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "markdownlint-cli": "^0.44.0",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "prettier": "3.5.3",
    "yaml-lint": "^1.7.0"
  }
}
